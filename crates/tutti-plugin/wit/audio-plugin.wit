// DAWAI Audio Plugin API - WebAssembly Interface Types (WIT)
//
// The contract that sandboxed audio DSP guests implement to be loaded
// by `tutti-plugin-server` as a WASM Component. Sibling to the editor
// extension world (`dawai:extension`); the two are intentionally
// separated, mirroring the browser-audio split between the main thread
// and AudioWorkletGlobalScope.
//
// **What this world deliberately does NOT have**: no host imports. No
// network, no storage, no UI, no async. Like AudioWorkletGlobalScope,
// the API surface available inside `process` is exactly what's needed
// to turn audio + MIDI + parameters into more audio + MIDI. WASI core
// (clocks, random, stdio) is bound by the runtime; everything else is
// out of scope by design.
//
// Parameters, transport state, and note expressions are NOT in the
// process call signature — they ride the existing tutti-plugin
// parameter-change IPC and are queued before each block. Keeping the
// WIT minimal means fewer marshalling bytes per block and a smaller
// surface for a v0.2 to maintain backwards-compatibility on.

package dawai:audio-plugin@0.1.0;

interface plugin {
    use dawai:common/types@0.1.0.{midi-event, parameter-info, audio-io, midi-io};

    /// What the guest reports at `init` time. Mirrors the host-side
    /// `PluginInfo` shape closely so the wasmtime adapter has a
    /// one-to-one conversion.
    record metadata {
        name: string,
        vendor: string,
        version: string,
        audio: audio-io,
        midi: midi-io,
        parameters: list<parameter-info>,
        /// Plugin's reported processing latency, in samples. Reported
        /// once at init; if the guest needs to change it later, it
        /// should restart (v0.2 may add `latency-changed` async).
        latency-samples: u32,
    }

    /// Side-channel outputs from one `process` call beyond the audio
    /// buffer itself.
    record process-output {
        /// MIDI events the plugin wants to emit downstream during the
        /// processed block. Time offsets are within-block frames.
        midi: list<midi-event>,
    }

    /// Called once after instantiation. The guest reports its
    /// metadata; the host honors `audio.outputs` for buffer sizing.
    /// `max-block-size` is the upper bound for any future `process`
    /// call's input/output sample count; the guest may pre-allocate.
    init: func(sample-rate: f64, max-block-size: u32) -> result<metadata, string>;

    /// Sample-rate change between blocks. Guest may rebuild filters /
    /// resamplers. Called from a non-audio thread; the guest should
    /// not assume `process` is in flight.
    set-sample-rate: func(rate: f64);

    /// Process one audio block. Inputs are planar f32: outer list is
    /// per-channel, inner list is per-sample. Outputs are returned
    /// the same way; the host honors `audio.outputs` from `init` for
    /// the expected number of channels.
    ///
    /// `midi-in` carries any MIDI events scheduled within the block;
    /// time offsets are within-block frame counts.
    ///
    /// On Err, the host marks the call failed and (for now) mutes
    /// this plugin's output for the block. Subsequent calls may
    /// still succeed; one error does not poison the instance.
    process: func(
        inputs: list<list<f32>>,
        midi-in: list<midi-event>,
    ) -> result<tuple<list<list<f32>>, process-output>, string>;

    /// Set a parameter to a normalized 0..1 value. `id` matches one
    /// reported in `metadata.parameters`. Setting an unknown id is a
    /// no-op (not an error — the host may have stale parameter info).
    set-parameter: func(id: u32, value: f64);

    /// Read a parameter's current normalized 0..1 value. Returns 0.0
    /// for an unknown id (matching VST3/CLAP fallback behavior).
    get-parameter: func(id: u32) -> f64;

    /// Serialize the plugin's full state for save/restore (presets,
    /// project files). Opaque bytes; the guest defines the format.
    get-state: func() -> result<list<u8>, string>;

    /// Restore from `get-state` output. The guest is responsible for
    /// versioning if its format changes between releases.
    set-state: func(data: list<u8>) -> result<_, string>;

    /// Reset internal state (clear delay lines, reset oscillators,
    /// flush voice allocator) without changing parameters or sample
    /// rate. Called when the host repositions transport, etc.
    reset: func();
}

world audio-plugin {
    export plugin;
}
