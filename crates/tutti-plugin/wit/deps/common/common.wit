// LOCKSTEP-MIRROR of `dawai:common@0.1.0` from the dawai-extensions
// crate, copied here so `tutti-plugin-server`'s wit-bindgen can resolve
// the import without a cross-repo path dependency.
//
// CANONICAL FILE: `crates/dawai-extensions/wit/deps/common/common.wit`
// (in the parent repo). Any change there MUST be mirrored here.
// Search the repo for "LOCKSTEP-MIRROR" to find the canonical copy.
//
// Why this lives here: tutti is a sub-workspace and its bindgen!
// invocation can't reach files outside `crates/tutti/crates/tutti-plugin/`.
// We accept the duplication because (a) the file is small, (b) it has
// changed exactly once across the entire W1-W7 batch, and (c) the
// alternatives (build script, dedicated crate, gitignored regen)
// add more ceremony than they remove. See W8 in the plan if this ever
// stops being true.

package dawai:common@0.1.0;

interface types {
    /// One raw MIDI message routed to or from a plugin/extension.
    /// `time-frames` is the offset within the current audio block at
    /// sample rate. `data` is the raw MIDI message body (typically 1-3
    /// bytes for channel messages, longer for SysEx).
    record midi-event {
        time-frames: u32,
        data: list<u8>,
    }

    /// Audio I/O configuration declared by an audio plugin.
    record audio-io {
        inputs: u32,
        outputs: u32,
    }

    /// MIDI I/O configuration declared by an audio plugin.
    record midi-io {
        receives: bool,
        sends: bool,
    }

    /// Description of one plugin parameter. `id` is opaque to the host
    /// (the plugin chooses); the host references parameters by id when
    /// calling set-parameter / get-parameter.
    record parameter-info {
        id: u32,
        name: string,
        /// Normalized 0..1.
        default-value: f64,
        /// Normalized 0..1 (may be 0).
        min-value: f64,
        /// Normalized 0..1 (may be 1).
        max-value: f64,
        /// Display unit (e.g. "dB", "Hz", "%"). Empty if unitless.
        unit: string,
    }
}
